# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Model Home runner output
# The Modelfile redirects stdout to run/<output>.output.json; that's per-invocation,
# not source.
run/
*.output.json

# Claude Code local state
# .claude/ itself is committed on purpose: the vendored feat skill lives in
# .claude/skills/feat/. Ignore only machine- or user-specific settings.
.claude/settings.local.json
.claude/*.local.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Build download caches. The committed artifacts are climatology.csv and
# baseline_yields.csv, not the raw archive responses or the crop-parameter
# checkout build_baselines.py reads.
.climatology-cache/
.crop-parameters-cache/
# The Dockerfile bakes the crop parameters into the image at /app/crop_parameters.
# Running the model or check_yield.py locally against the same pinned commit means
# putting a copy (or a link) here, which is a third-party checkout, not source.
corn-yield/crop_parameters

# Credentials. No bundle here needs a key today -- Open-Meteo's archive is
# keyless and PCSE's crop parameters ship inside the pip package -- but these
# belong in the home directory either way. Never commit a copy.
.cdsapirc
.netrc
*.pem
.env
.env.*
